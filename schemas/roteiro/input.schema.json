{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio",
            "json",
            "text"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "kind"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Research": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Title"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "selected_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Id"
        }
      },
      "required": [
        "summary",
        "sources",
        "candidates"
      ],
      "title": "Research",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "excerpt"
      ],
      "title": "Source",
      "type": "object"
    },
    "ThumbnailCandidate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/Artifact"
        }
      },
      "required": [
        "id",
        "prompt",
        "image"
      ],
      "title": "ThumbnailCandidate",
      "type": "object"
    },
    "Thumbnails": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/ThumbnailCandidate"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "selected_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Id"
        }
      },
      "required": [
        "candidates"
      ],
      "title": "Thumbnails",
      "type": "object"
    },
    "Title": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "angle": {
          "minLength": 1,
          "title": "Angle",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9_-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "angle",
        "rationale",
        "source_ids"
      ],
      "title": "Title",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "topic": {
      "minLength": 1,
      "title": "Topic",
      "type": "string"
    },
    "research": {
      "$ref": "#/$defs/Research"
    },
    "thumbnail": {
      "$ref": "#/$defs/Thumbnails"
    }
  },
  "required": [
    "topic",
    "research",
    "thumbnail"
  ],
  "title": "ThumbnailOutput",
  "type": "object"
}
